{
  "manifest_version": 3,
  "name": "TikTok Nama Komentar",
  "description": "Ambil nama tampilan (nickname) orang yang berkomentar di video TikTok, lalu salin untuk ditempel ke Excel.",
  "version": "1.1.2",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TikTok Nama Komentar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "tabs", "webRequest"],
  "host_permissions": ["*://*.tiktok.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
