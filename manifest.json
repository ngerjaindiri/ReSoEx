{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "ReSo Ekstention",
  "description": "Ambil nama komentator dari Facebook, TikTok & Instagram, lalu salin ke Excel. Satu extension untuk semua platform.",
  "version": "1.0.27",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ReSo Ekstention",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "tabs", "webRequest", "contextMenus", "cookies"],
  "commands": {
    "run-extract": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "ReSo — Proses / ambil nama komentator di tab aktif"
    },
    "copy-names": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "ReSo — Salin nama komentator ke clipboard"
    }
  },
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*",
    "https://facebook.com/*",
    "*://*.facebook.com/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://facebook.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["content-fb.js"],
      "css": ["content-fb.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content-tiktok.js"],
      "css": ["content-tiktok.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content-ig.js"],
      "css": ["content-ig.css"],
      "run_at": "document_idle"
    }
  ]
}
